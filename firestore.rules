rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Equipment Collection
    match /equipments/{equipmentId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isSignedIn() && (resource == null || resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Bookings Collection
    match /bookings/{bookingId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isAdmin();
    }

    // Reviews Collection (Equipment star ratings and rental experience feedback)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isSignedIn() || isAdmin();
    }
  }
}
