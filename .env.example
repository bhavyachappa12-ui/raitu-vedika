# GEMINI_API_KEY: Required for Gemini AI Agricultural Advisory & Diagnosis
GEMINI_API_KEY=""

# APP_URL: Local host URL for self-referential links and APIs
APP_URL="http://localhost:3000"

# ==============================================================================
# FIREBASE CONFIGURATION (For local VS Code development & Firebase Console)
# Obtain from: Firebase Console -> Project Settings (gear icon) -> General -> "Your apps" (Web app)
# ==============================================================================
FIREBASE_PROJECT_ID="raitu-vedika"
FIREBASE_DATABASE_ID="(default)"
FIREBASE_API_KEY=""
FIREBASE_AUTH_DOMAIN="raitu-vedika.firebaseapp.com"
FIREBASE_STORAGE_BUCKET="raitu-vedika.firebasestorage.app"
FIREBASE_APP_ID=""
FIREBASE_MESSAGING_SENDER_ID=""

# Optional VITE_ prefixed mirrors (Vite automatically shares both to client and server)
VITE_FIREBASE_PROJECT_ID="raitu-vedika"
VITE_FIREBASE_DATABASE_ID="(default)"
VITE_FIREBASE_API_KEY=""

# ==============================================================================
# OPTIONAL EMAIL OTP CONFIGURATION (falls back to secure console/in-app OTP if empty)
# ==============================================================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="e-Raitu Vedika Security <no-reply@eraitu.app>"

